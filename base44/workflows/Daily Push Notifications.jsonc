{
  "name": "Daily Push Notifications",
  "description": "Sends each user a daily push notification summarizing their overdue/due acts of support and prayer/health/care reminders (8:30am America/Chicago, staggered 30min after the digest to avoid shared rate-limit contention). Runs in 4 sequential shards so each invocation stays well under the 5-minute timeout as the user base grows, and each shard only builds reminders for the users it will actually send to. Requires a native iOS/Android build with push credentials configured.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "30 8 * * *",
      "one_time_date": null,
      "timezone": "America/Chicago",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_push_notifications",
      "version": "1.3",
      "namespace": "base44"
    },
    "do": [
      {
        "shard_0": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "send-daily-push-notifications",
            "args": {
              "shard": 0,
              "totalShards": 4
            }
          },
          "then": "shard_1",
          "x-base44": {
            "title": "Push shard 1 of 4",
            "description": "First quarter of users"
          }
        }
      },
      {
        "shard_1": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "send-daily-push-notifications",
            "args": {
              "shard": 1,
              "totalShards": 4
            }
          },
          "then": "shard_2",
          "x-base44": {
            "title": "Push shard 2 of 4",
            "description": "Second quarter of users"
          }
        }
      },
      {
        "shard_2": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "send-daily-push-notifications",
            "args": {
              "shard": 2,
              "totalShards": 4
            }
          },
          "then": "shard_3",
          "x-base44": {
            "title": "Push shard 3 of 4",
            "description": "Third quarter of users"
          }
        }
      },
      {
        "shard_3": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "send-daily-push-notifications",
            "args": {
              "shard": 3,
              "totalShards": 4
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Push shard 4 of 4",
            "description": "Final quarter of users"
          }
        }
      }
    ]
  }
}