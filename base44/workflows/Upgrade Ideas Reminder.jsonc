{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 14,
      "interval_unit": "days",
      "interval_anchor": "2026-08-25T09:00:00Z",
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "upgrade_ideas_reminder",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_reminder": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "send-upgrade-reminder"
          },
          "then": "end",
          "x-base44": {
            "title": "Send upgrade reminder email",
            "description": "Bi-weekly list of open ideas"
          }
        }
      }
    ]
  },
  "description": "Emails the admin the list of open FutureUpgrade ideas every 2 weeks",
  "name": "Upgrade Ideas Reminder"
}