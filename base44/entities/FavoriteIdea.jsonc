{
  "name": "FavoriteIdea",
  "type": "object",
  "properties": {
    "category": {
      "type": "string",
      "enum": [
        "vacationIdeas",
        "getawayIdeas",
        "roadTripIdeas",
        "dinnerIdeas"
      ]
    },
    "title": {
      "type": "string"
    },
    "destination": {
      "type": "string"
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "category",
    "title"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}