{
  "name": "Person",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "preferredName": {
      "type": "string"
    },
    "relation": {
      "type": "string"
    },
    "birthday": {
      "type": "string"
    },
    "anniversary": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "photoUrl": {
      "type": "string"
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Gallery of uploaded photos for this contact"
    },
    "zipCode": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "description": "Email address for the contact, used for bulk messaging"
    },
    "giftBudget": {
      "type": "string",
      "description": "Optional per-person gift budget as free text, shown and editable on the connection card (e.g. '$100' or '$50\u2013$100')"
    },
    "accountCheckCharged": {
      "type": "boolean",
      "default": false,
      "description": "Internal bookkeeping: true once this contact's email has been counted against the owner's all-time account-check budget, so re-checking an address they already checked stays free. Not part of the contact's profile."
    },
    "likes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "details": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        },
        "required": [
          "label",
          "value"
        ]
      }
    },
    "otherItems": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Custom notes or facts about the contact that feed into AI gift and message suggestions"
    },
    "preferences": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "relationships": {
      "type": "array",
      "description": "Links to other connections \u2014 people or pets \u2014 in the user's connections (e.g. spouse, child, parent, pet). Only targets that are also the user's own connections are shown.",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "personId": {
            "type": "string",
            "description": "Id of the related Person (omitted when the link is to a Pet)"
          },
          "petId": {
            "type": "string",
            "description": "Id of the related Pet (omitted when the link is to a Person)"
          },
          "type": {
            "type": "string",
            "description": "Relationship type label, e.g. Spouse, Child, Parent, Pet"
          }
        },
        "required": [
          "type"
        ]
      }
    },
    "notify": {
      "type": "boolean",
      "default": true
    },
    "healthNotes": {
      "type": "string",
      "description": "Freeform notes about the contact's health or personal situation"
    },
    "healthReminderDays": {
      "type": "number",
      "description": "Cadence in days for health check-in reminders (0/null = off)"
    },
    "healthReminderEndDate": {
      "type": "string",
      "format": "date",
      "description": "Optional date after which health check-in reminders stop"
    },
    "lastHealthCheckIn": {
      "type": "string",
      "format": "date-time"
    },
    "healthSnoozedUntil": {
      "type": "string",
      "format": "date-time",
      "description": "When set to a future timestamp, the health check-in reminder is temporarily hidden (snoozed) until that time passes."
    },
    "prayerEnabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether prayer reminders are enabled for this contact"
    },
    "prayerNames": {
      "type": "string",
      "description": "Names of people to pray for"
    },
    "prayerReason": {
      "type": "string",
      "description": "Reason or intention for prayer"
    },
    "prayerReminderDays": {
      "type": "number",
      "description": "Cadence in days for prayer reminders (0/null = off)"
    },
    "prayerReminderEndDate": {
      "type": "string",
      "format": "date",
      "description": "Optional date after which prayer reminders stop"
    },
    "lastPrayedAt": {
      "type": "string",
      "format": "date-time"
    },
    "prayerSnoozedUntil": {
      "type": "string",
      "format": "date-time",
      "description": "When set to a future timestamp, the prayer check-in reminder is temporarily hidden (snoozed) until that time passes."
    },
    "otherNotes": {
      "type": "string",
      "description": "Freeform notes for a custom care reminder"
    },
    "otherReminderDays": {
      "type": "number",
      "description": "Cadence in days for other care check-in reminders (0/null = off)"
    },
    "otherReminderEndDate": {
      "type": "string",
      "format": "date",
      "description": "Optional date after which other care reminders stop"
    },
    "lastOtherCheckIn": {
      "type": "string",
      "format": "date-time"
    },
    "reachOutDays": {
      "type": "number",
      "description": "Cadence in days for reach-out reminders (0/null = off)"
    },
    "lastReachedOutAt": {
      "type": "string",
      "format": "date-time"
    },
    "remembering": {
      "type": "boolean",
      "default": false,
      "description": "True when this person has passed away or is no longer in the user's life. Keeps their photos, notes and memories, but replaces birthdays, anniversaries, gift and check-in reminders with one annual remembrance reminder."
    },
    "remembranceDate": {
      "type": "string",
      "format": "date",
      "description": "The date the user keeps for this person (the day they passed, or the day they last had them in their life). Rolls forward every year for the remembrance reminder."
    },
    "remembranceNote": {
      "type": "string",
      "description": "What the user would like to do on the remembrance day, e.g. 'Light a candle' or 'Visit the garden'."
    },
    "remembranceLeadDays": {
      "type": "number",
      "description": "How many days before the remembrance date to start reminding (defaults to 3)."
    },
    "remembrancePhotos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Pictures kept with this person's remembrance date. Each entry is a private storage URI, shown through a short-lived signed URL \u2014 never a public link, and only ever visible to the account owner."
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}