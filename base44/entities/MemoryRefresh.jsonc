{
  "name": "MemoryRefresh",
  "type": "object",
  "properties": {
    "personId": {
      "type": "string",
      "description": "Id of the Person (contact) this memory refresh reminder is about"
    },
    "label": {
      "type": "string",
      "description": "What happened \u2014 the memory to refresh later (e.g. 'Coffee with Mom')"
    },
    "sourceType": {
      "type": "string",
      "description": "Where the memory originated: act, event, milestone, gift, trip, goal, note, manual"
    },
    "sourceId": {
      "type": "string",
      "description": "Id of the source record, for optional deep-linking"
    },
    "refreshAt": {
      "type": "string",
      "format": "date-time",
      "description": "When to surface the reminder in the notification feed"
    },
    "done": {
      "type": "boolean",
      "default": false,
      "description": "True once the user has acknowledged or dismissed the reminder"
    }
  },
  "required": [
    "personId",
    "label",
    "refreshAt"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}